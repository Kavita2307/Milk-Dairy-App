generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Animal {
  id           Int      @id @default(autoincrement())
  animalNumber String
  userId       Int
  groupId      Int
  details      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Ration {
  id Int @id @default(autoincrement())

  groupId Int
  userId  Int

  user User @relation(fields: [userId], references: [id])

  name       String
  no         Int
  kg         Float
  total      Float
  thisLoad   Float
  lastLoad   Float
  diff       Float
  rationSize Float
  days       Int

  createdAt DateTime @default(now())
}

model Leftover {
  id Int @id @default(autoincrement())

  groupId    Int
  date       DateTime @default(now())
  leftoverKg Float
  userId     Int
}

model Milk {
  id Int @id @default(autoincrement())

  groupId      Int
  shift        String // morning / afternoon / evening
  milkLit      Float
  animalNumber String
  date         DateTime @default(now())
  userId       Int
}

model Ingredient {
  id Int @id @default(autoincrement())

  name         String @unique // Feed, Silage, Wheat straw
  details      Json? // price, dryMatter etc.
  currentStock Float  @default(0) // Available stock (kg)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  stockEntries      StockEntry[]
  consumptions      Consumption[]
  rationIngredients RationIngredient[]
}

model StockEntry {
  id           Int     @id @default(autoincrement())
  user         Int
  ingredientId Int
  quantity     Float // kg
  note         String?

  createdAt DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model Consumption {
  id           Int     @id @default(autoincrement())
  groupId      Int
  ingredientId Int
  quantity     Float // kg used
  note         String?

  createdAt DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  mobile      String       @unique
  email       String?      @unique
  password    String
  createdAt   DateTime     @default(now())
  role        Role         @default(farmer)
  isApproved  Boolean      @default(false)
  address     String?
  pincode     String?
  animals     Animal[]
  Ration      Ration[]
  ingredients Ingredient[]
}

enum Role {
  farmer
  admin
}

model AdminRation {
  id          Int      @id @default(autoincrement())
  groupId     Int // 1,2,3
  days        Int
  kgPerAnimal Float
  createdAt   DateTime @default(now())

  ingredients AdminRationIngredient[]
}

model AdminRationIngredient {
  id         Int    @id @default(autoincrement())
  rationId   Int
  name       String
  quantityKg Float
  dmPercent  Float

  ration AdminRation @relation(fields: [rationId], references: [id])
}

model RationPlan {
  id        Int      @id @default(autoincrement())
  date      DateTime
  createdBy Int
  createdAt DateTime @default(now())

  groups RationGroup[]

  @@unique([date])
}

model RationGroup {
  id           Int @id @default(autoincrement())
  rationPlanId Int
  groupId      Int // High / Medium / Low
  animalCount  Int

  rationPercentage Float // e.g. 50%
  plannedTmrQty    Float // planned total TMR
  offeredTmrQty    Float // after % calculation

  createdAt DateTime @default(now())

  rationPlan  RationPlan         @relation(fields: [rationPlanId], references: [id])
  ingredients RationIngredient[]

  feedCompleted Boolean   @default(false)
  fedAt         DateTime?

  @@unique([rationPlanId, groupId])
}

model RationIngredient {
  id            Int @id @default(autoincrement())
  rationGroupId Int
  ingredientId  Int

  qtyPerAnimal Float
  totalQty     Float // qtyPerAnimal * animalCount
  dmPercent    Float
  dmKg         Float

  mixTimeMinutes Int

  createdAt DateTime @default(now())

  rationGroup RationGroup @relation(fields: [rationGroupId], references: [id])
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id])

  mixLogs RationMixLog[]
}

model RationMixLog {
  id                 Int @id @default(autoincrement())
  rationIngredientId Int

  plannedQty      Float
  actualQty       Float
  accuracyPercent Float

  createdAt DateTime @default(now())

  rationIngredient RationIngredient @relation(fields: [rationIngredientId], references: [id])
}
