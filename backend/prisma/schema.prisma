generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  farmer
  admin
}

enum RationStatus {
  DRAFT
  FED
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  mobile     String   @unique
  email      String?  @unique
  password   String
  role       Role     @default(farmer)
  isApproved Boolean  @default(false)
  address    String?
  pincode    String?
  createdAt  DateTime @default(now())

  animals      Animal[]
  rations      Ration[]
  ingredients  Ingredient[]
  stockEntries StockEntry[]
  consumptions Consumption[]
  milkRecords  Milk[]
  leftovers    Leftover[]
  rationPlans  RationPlan[]
}

model Animal {
  id           Int      @id @default(autoincrement())
  animalNumber String
  userId       Int
  groupId      Int
  details      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User   @relation(fields: [userId], references: [id])
  milk Milk[]
}

model Ration {
  id Int @id @default(autoincrement())

  groupId Int
  userId  Int

  name       String
  no         Int
  kg         Float
  total      Float
  thisLoad   Float
  lastLoad   Float
  diff       Float
  rationSize Float
  days       Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Leftover {
  id Int @id @default(autoincrement())

  groupId    Int
  date       DateTime @default(now())
  leftoverKg Float
  userId     Int

  user User @relation(fields: [userId], references: [id])
}

model Milk {
  id      Int      @id @default(autoincrement())
  groupId Int
  shift   String
  milkLit Float
  date    DateTime @default(now())

  userId   Int
  animalId Int

  user   User   @relation(fields: [userId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])
}

model Ingredient {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  details      Json?
  currentStock Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  stockEntries      StockEntry[]
  consumptions      Consumption[]
  rationIngredients RationIngredient[]
}

model StockEntry {
  id           Int      @id @default(autoincrement())
  userId       Int
  ingredientId Int
  quantity     Float
  note         String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model Consumption {
  id           Int      @id @default(autoincrement())
  groupId      Int
  ingredientId Int
  quantity     Float
  note         String?
  createdAt    DateTime @default(now())

  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model AdminRation {
  id          Int      @id @default(autoincrement())
  groupId     Int
  days        Int
  kgPerAnimal Float
  createdAt   DateTime @default(now())

  ingredients AdminRationIngredient[]
}

model AdminRationIngredient {
  id         Int    @id @default(autoincrement())
  rationId   Int
  name       String
  quantityKg Float
  dmPercent  Float

  ration AdminRation @relation(fields: [rationId], references: [id])
}

model RationPlan {
  id        Int      @id @default(autoincrement())
  date      DateTime
  createdBy Int
  createdAt DateTime @default(now())

  user   User          @relation(fields: [createdBy], references: [id])
  groups RationGroup[]
}

model RationGroup {
  id               Int          @id @default(autoincrement())
  rationPlanId     Int
  groupId          Int
  animalCount      Int
  rationPercentage Float
  plannedTmrQty    Float
  offeredTmrQty    Float
  leftoverQty      Float?
  status           RationStatus @default(DRAFT)
  createdBy        Int
  createdAt        DateTime     @default(now())

  rationPlan  RationPlan         @relation(fields: [rationPlanId], references: [id])
  ingredients RationIngredient[]
  mixLogs     MixLog[]
}

model RationIngredient {
  id             Int   @id @default(autoincrement())
  rationGroupId  Int
  ingredientId   Int
  qtyPerAnimal   Float
  animalCount    Int
  totalQty       Float
  dmPercent      Float
  mixTimeMinutes Int

  rationGroup RationGroup @relation(fields: [rationGroupId], references: [id])
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id])
}

model MixLog {
  id                 Int     @id @default(autoincrement())
  rationGroupId      Int
  rationIngredientId Int
  plannedQty         Float
  actualQty          Float
  accuracyPercent    Float

  rationGroup      RationGroup      @relation(fields: [rationGroupId], references: [id])
  rationIngredient RationIngredient @relation(fields: [rationIngredientId], references: [id])
}

